# Copy to .env (never commit .env). All values are read by the api container.

# One-time token needed to complete first-run setup in the browser. Use a long random value:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ARTHA_SETUP_TOKEN=

# Cookies are Secure (HTTPS only). Set to false ONLY for local http development.
ARTHA_COOKIE_SECURE=true
ARTHA_SESSION_TTL_HOURS=12
ARTHA_KEEP_VERSIONS=30
ARTHA_TIMEZONE=Asia/Kolkata

# Google Drive backup (optional). See docs/DEPLOY.md -> "Google Drive backup".
ARTHA_GDRIVE_CLIENT_ID=
ARTHA_GDRIVE_CLIENT_SECRET=
ARTHA_GDRIVE_REFRESH_TOKEN=
ARTHA_GDRIVE_FOLDER_ID=
ARTHA_BACKUP_TIME=03:00
ARTHA_BACKUP_KEEP_DAILY=30
ARTHA_BACKUP_KEEP_MONTHLY=12

# Public mutual-fund data relays (no user data is sent).
ARTHA_AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
# Historical NAV provider: mfapi (unofficial, https://www.mfapi.in) or none
ARTHA_NAV_HISTORY_PROVIDER=mfapi

# Host port for the web container (bound to 127.0.0.1 only).
ARTHA_WEB_PORT=8080
